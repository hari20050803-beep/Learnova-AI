rules_version = '2';

// Learnova AI - Firestore Security Rules (final version)
//
// Each logged-in student can read/write ONLY their own data:
//   users/{uid}                 - profile (created at registration)
//   users/{uid}/chat_history    - AI chatbot messages
//   users/{uid}/quiz_history    - AI quiz results
//   users/{uid}/summaries       - AI notes summaries
//
// HOW TO APPLY:
//   Firebase Console -> Firestore Database -> Rules tab ->
//   replace everything with this file -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // The user's profile document AND every subcollection under it.
    // {document=**} makes the rule cover chat_history, quiz_history,
    // summaries and any future subcollection.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Everything else is denied by default.
  }
}
